{
  "name": "md-me",
  "version": "1.0.0",
  "description": "个人博客系统",
  "private": true,
  "egg": {
    "declarations": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "egg": "^3.17.5",
    "egg-cors": "^3.0.1",
    "egg-jwt": "^3.1.7",
    "egg-redis": "^2.6.1",
    "egg-scripts": "2",
    "egg-sequelize": "^6.0.0",
    "egg-validate": "^2.0.2",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^17.0.1",
    "mysql2": "^3.16.2"
  },
  "devDependencies": {
    "egg-bin": "6",
    "egg-mock": "5",
    "eslint": "8",
    "eslint-config-egg": "13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "egg-scripts start --daemon --title=egg-server-md-me",
    "stop": "egg-scripts stop --title=egg-server-md-me",
    "dev": "egg-bin dev",
    "dev:all": "concurrently \"npm run dev\" \"cd frontend && npm run dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "init-db": "node init-db.js",
    "test": "npm run lint -- --fix && npm run test:local",
    "test:local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint .",
    "ci": "npm run lint && npm run cov"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "daxian",
  "license": "MIT"
}

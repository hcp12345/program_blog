# ============================================================
# MD Blog 环境变量模板
# 使用：cp .env.example .env  然后按需修改
# ============================================================

# ---------------- 端口 ----------------
# 前端对外访问端口（浏览器访问 http://localhost:8080）
WEB_PORT=8080
# 数据库对外映射端口（仅调试用，避开本机可能已有的 3306）
DB_EXPOSE_PORT=3307

# ---------------- 数据库 ----------------
DB_NAME=md_me_blog
DB_USER=root
DB_PASSWORD=change-me-strong-password
# 后端 worker 进程数（1~2 核的小服务器建议 1）
EGG_WORKERS=1

# ---------------- 安全密钥（生产环境必须改成随机值） ----------------
# 生成方式：openssl rand -hex 32
# 留空时会退回代码中的开发默认值，生产环境请务必填写
APP_KEYS=
JWT_SECRET=

# ---------------- AI 智能客服（智谱 GLM） ----------------
# 留空则 AI 对话返回「智能客服尚未配置」，其余功能不受影响
# Key 申请：https://open.bigmodel.cn/
ZHIPU_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
